use "std/linux.cst" as linux;
use "../init.cst" as init;
use "../video.cst" as video;
use "../events.cst" as events;
use "../render.cst" as render;
use "../rect.cst" as rect;
use "../timer.cst" as timer;
use "../ttf.cst" as ttf;
use "../surface.cst" as surface;

fn print(s as *u8, len as i64) as void {
    linux.write(1, s, len);
}

fn main() as i32 {
    let is bool as r = init.init(init.VIDEO);
    if (cast(i32, r) == 0) { print("init fail\n", 10); linux.exit(1); }

    let is bool as tr = ttf.init();
    if (cast(i32, tr) == 0) { print("ttf init fail\n", 14); init.quit(); linux.exit(1); }

    let is *u8 as win = video.create_window("hello caustic-sdl3", 800, 600, 0);
    if (cast(i64, win) == 0) { print("win fail\n", 9); ttf.quit(); init.quit(); linux.exit(2); }

    let is *u8 as ren = render.create_renderer(win);
    if (cast(i64, ren) == 0) { print("ren fail\n", 9); video.destroy_window(win); ttf.quit(); init.quit(); linux.exit(3); }

    let is *u8 as font = ttf.open_font("/usr/share/fonts/TTF/DejaVuSans.ttf", 72.0);
    if (cast(i64, font) == 0) { print("font fail\n", 10); render.destroy(ren); video.destroy_window(win); ttf.quit(); init.quit(); linux.exit(4); }

    let is i32 as white = ttf.color(255, 255, 255, 255);
    let is *u8 as surf = ttf.render_text(font, "Hello World!", 12, white);
    if (cast(i64, surf) == 0) { print("text fail\n", 10); linux.exit(5); }

    let is *u8 as tex = render.texture_from_surface(ren, surf);
    surface.destroy(surf);

    let is [16]u8 as dst;
    rect.makef(&dst, 100.0, 220.0, 600.0, 160.0);

    let is i32 as running with mut = 1;
    while (running == 1) {
        render.set_color(ren, 30, 30, 60, 255);
        render.clear(ren);

        render.render_texture(ren, tex, cast(*u8, 0), &dst);

        render.present(ren);
        timer.delay(16);

        let is i32 as ev with mut = events.poll();
        while (ev != 0) {
            if (ev == events.QUIT) { running = 0; }
            if (ev == events.WINDOW_CLOSE) { running = 0; }
            ev = events.poll();
        }
    }

    render.destroy_texture(tex);
    ttf.close_font(font);
    render.destroy(ren);
    video.destroy_window(win);
    ttf.quit();
    init.quit();
    return 0;
}
