use "std/linux.cst" as linux;
use "../init.cst" as init;
use "../video.cst" as video;
use "../events.cst" as events;
use "../render.cst" as render;
use "../rect.cst" as rect;
use "../timer.cst" as timer;

// TTF directly — wrapper has float passing bug
extern fn TTF_Init() as bool;
extern fn TTF_Quit() as void;
extern fn TTF_OpenFont(file as *u8, ptsize as f32) as *u8;
extern fn TTF_CloseFont(font as *u8) as void;
extern fn TTF_RenderText_Blended(font as *u8, text as *u8, length as i64, fg as i32) as *u8;

fn print(s as *u8, len as i64) as void {
    linux.write(1, s, len);
}

fn color(r as i32, g as i32, b as i32, a as i32) as i32 {
    return r + g * 256 + b * 65536 + a * 16777216;
}

fn main() as i32 {
    let is bool as r = init.init(init.VIDEO);
    if (cast(i32, r) == 0) { print("init fail\n", 10); linux.exit(1); }

    let is bool as tr = TTF_Init();
    if (cast(i32, tr) == 0) { print("ttf init fail\n", 14); init.quit(); linux.exit(1); }

    let is *u8 as win = video.create_window("hello caustic-sdl3", 800, 600, 0);
    if (cast(i64, win) == 0) { print("win fail\n", 9); TTF_Quit(); init.quit(); linux.exit(2); }

    let is *u8 as ren = render.create_renderer(win);
    if (cast(i64, ren) == 0) { print("ren fail\n", 9); video.destroy_window(win); TTF_Quit(); init.quit(); linux.exit(3); }

    let is *u8 as font = TTF_OpenFont("/usr/share/fonts/TTF/DejaVuSans.ttf", 72.0);
    if (cast(i64, font) == 0) { print("font fail\n", 10); render.destroy(ren); video.destroy_window(win); TTF_Quit(); init.quit(); linux.exit(4); }
    print("font ok\n", 8);

    let is i32 as white = color(255, 255, 255, 255);
    let is *u8 as surf = TTF_RenderText_Blended(font, "Hello World!", 12, white);
    if (cast(i64, surf) == 0) { print("text fail\n", 10); linux.exit(5); }
    print("text ok\n", 8);

    let is *u8 as tex = render.texture_from_surface(ren, surf);

    let is [16]u8 as dst;
    rect.makef(&dst, 100.0, 220.0, 600.0, 160.0);

    print("running\n", 8);
    let is i32 as running with mut = 1;
    while (running == 1) {
        render.set_color(ren, 30, 30, 60, 255);
        render.clear(ren);

        render.render_texture(ren, tex, cast(*u8, 0), &dst);

        render.present(ren);
        timer.delay(16);

        let is i32 as ev with mut = events.poll();
        while (ev != 0) {
            if (ev == events.QUIT) { running = 0; }
            if (ev == events.WINDOW_CLOSE) { running = 0; }
            ev = events.poll();
        }
    }

    print("done\n", 5);
    render.destroy_texture(tex);
    TTF_CloseFont(font);
    render.destroy(ren);
    video.destroy_window(win);
    TTF_Quit();
    init.quit();
    linux.exit(0);
    return 0;
}
