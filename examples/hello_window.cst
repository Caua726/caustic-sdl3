use "std/linux.cst" as linux;
use "../init.cst" as init;
use "../video.cst" as video;
use "../events.cst" as events;
use "../render.cst" as render;
use "../rect.cst" as rect;
use "../timer.cst" as timer;

fn print(s as *u8, len as i64) as void {
    linux.write(1, s, len);
}

// draw a single pixel-block at grid position (gx, gy) with given size
fn block(ren as *u8, ox as f32, oy as f32, gx as f32, gy as f32, sz as f32) as void {
    let is [16]u8 as r;
    rect.makef(&r, ox + gx * sz, oy + gy * sz, sz, sz);
    render.fill_rect(ren, &r);
}

// draw "HELLO" as pixel-art (5 letters, each 5 tall, varying width)
fn draw_hello(ren as *u8, ox as f32, oy as f32, sz as f32) as void {
    render.set_color(ren, 255, 255, 255, 255);

    // H
    block(ren, ox, oy, 0.0, 0.0, sz); block(ren, ox, oy, 0.0, 1.0, sz);
    block(ren, ox, oy, 0.0, 2.0, sz); block(ren, ox, oy, 0.0, 3.0, sz);
    block(ren, ox, oy, 0.0, 4.0, sz); block(ren, ox, oy, 1.0, 2.0, sz);
    block(ren, ox, oy, 2.0, 2.0, sz); block(ren, ox, oy, 3.0, 0.0, sz);
    block(ren, ox, oy, 3.0, 1.0, sz); block(ren, ox, oy, 3.0, 2.0, sz);
    block(ren, ox, oy, 3.0, 3.0, sz); block(ren, ox, oy, 3.0, 4.0, sz);

    // E (offset x by 5)
    let is f32 as ex = 5.0;
    block(ren, ox, oy, ex, 0.0, sz); block(ren, ox, oy, ex, 1.0, sz);
    block(ren, ox, oy, ex, 2.0, sz); block(ren, ox, oy, ex, 3.0, sz);
    block(ren, ox, oy, ex, 4.0, sz); block(ren, ox, oy, ex + 1.0, 0.0, sz);
    block(ren, ox, oy, ex + 2.0, 0.0, sz); block(ren, ox, oy, ex + 1.0, 2.0, sz);
    block(ren, ox, oy, ex + 2.0, 2.0, sz); block(ren, ox, oy, ex + 1.0, 4.0, sz);
    block(ren, ox, oy, ex + 2.0, 4.0, sz);

    // L (offset x by 10)
    let is f32 as lx = 10.0;
    block(ren, ox, oy, lx, 0.0, sz); block(ren, ox, oy, lx, 1.0, sz);
    block(ren, ox, oy, lx, 2.0, sz); block(ren, ox, oy, lx, 3.0, sz);
    block(ren, ox, oy, lx, 4.0, sz); block(ren, ox, oy, lx + 1.0, 4.0, sz);
    block(ren, ox, oy, lx + 2.0, 4.0, sz);

    // L (offset x by 14)
    let is f32 as l2x = 14.0;
    block(ren, ox, oy, l2x, 0.0, sz); block(ren, ox, oy, l2x, 1.0, sz);
    block(ren, ox, oy, l2x, 2.0, sz); block(ren, ox, oy, l2x, 3.0, sz);
    block(ren, ox, oy, l2x, 4.0, sz); block(ren, ox, oy, l2x + 1.0, 4.0, sz);
    block(ren, ox, oy, l2x + 2.0, 4.0, sz);

    // O (offset x by 18)
    let is f32 as oxx = 18.0;
    block(ren, ox, oy, oxx, 0.0, sz); block(ren, ox, oy, oxx, 1.0, sz);
    block(ren, ox, oy, oxx, 2.0, sz); block(ren, ox, oy, oxx, 3.0, sz);
    block(ren, ox, oy, oxx, 4.0, sz); block(ren, ox, oy, oxx + 1.0, 0.0, sz);
    block(ren, ox, oy, oxx + 2.0, 0.0, sz); block(ren, ox, oy, oxx + 1.0, 4.0, sz);
    block(ren, ox, oy, oxx + 2.0, 4.0, sz); block(ren, ox, oy, oxx + 3.0, 0.0, sz);
    block(ren, ox, oy, oxx + 3.0, 1.0, sz); block(ren, ox, oy, oxx + 3.0, 2.0, sz);
    block(ren, ox, oy, oxx + 3.0, 3.0, sz); block(ren, ox, oy, oxx + 3.0, 4.0, sz);
}

fn main() as i32 {
    let is bool as r = init.init(init.VIDEO);
    if (cast(i32, r) == 0) { print("init fail\n", 10); linux.exit(1); }
    print("init ok\n", 8);

    let is *u8 as win = video.create_window("hello caustic-sdl3", 800, 600, 0);
    if (cast(i64, win) == 0) { print("win fail\n", 9); init.quit(); linux.exit(2); }
    print("win ok\n", 7);

    let is *u8 as ren = render.create_renderer(win);
    if (cast(i64, ren) == 0) { print("ren fail\n", 9); video.destroy_window(win); init.quit(); linux.exit(3); }
    print("ren ok\n", 7);

    print("running\n", 8);
    let is i32 as running with mut = 1;
    while (running == 1) {
        render.set_color(ren, 30, 30, 60, 255);
        render.clear(ren);

        draw_hello(ren, 180.0, 240.0, 20.0);

        render.present(ren);
        timer.delay(16);

        let is i32 as ev with mut = events.poll();
        while (ev != 0) {
            if (ev == events.QUIT) { running = 0; }
            if (ev == events.WINDOW_CLOSE) { running = 0; }
            ev = events.poll();
        }
    }

    print("done\n", 5);
    render.destroy(ren);
    video.destroy_window(win);
    init.quit();
    linux.exit(0);
    return 0;
}
